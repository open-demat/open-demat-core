#!/usr/bin/env bash
set -euo pipefail

CORE="composer.core.json"
OVERLAY="composer.open_demat.json"
OUT="composer.json"

if ! command -v jq >/dev/null 2>&1; then
  echo "❌ jq is required (sudo apt-get install -y jq)" >&2
  exit 1
fi

if [ ! -f "$CORE" ]; then
  echo "❌ Missing $CORE" >&2
  exit 1
fi

if [ ! -f "$OVERLAY" ]; then
  echo "❌ Missing $OVERLAY" >&2
  exit 1
fi

jq . "$CORE" >/dev/null
jq . "$OVERLAY" >/dev/null

tmp_core="$(mktemp)"
tmp_out="$(mktemp)"

# 1) Si composer.json existe déjà :
#    sync core.require depuis OUT.require
#    en excluant :
#    - les dépendances open-demat/*
#    - les dépendances définies dans overlay.require
if [ -f "$OUT" ]; then
  jq . "$OUT" >/dev/null

  jq -n \
    --slurpfile core "$CORE" \
    --slurpfile overlay "$OVERLAY" \
    --slurpfile out "$OUT" \
    '
    ($core[0] // {}) as $c
    | ($overlay[0] // {}) as $o
    | ($out[0] // {}) as $x
    | ($o.require // {}) as $oReq
    | ($x.require // {}) as $xReq
    | ($xReq
        | with_entries(
            select(
              (.key | startswith("open-demat/") | not)
              and
              ($oReq[.key] | not)
            )
          )
      ) as $newCoreReq
    | $c
    | .require = $newCoreReq
    ' > "$tmp_core"

  mv "$tmp_core" "$CORE"
  echo "✅ Synced $CORE from existing $OUT"
else
  echo "ℹ️ $OUT not found, skipping sync from OUT to CORE"
fi

# 2) Rebuild composer.json = core + overlay
#    - merge require
#    - repositories prises depuis overlay
jq -n \
  --slurpfile core "$CORE" \
  --slurpfile overlay "$OVERLAY" \
  '
  ($core[0] // {}) as $c
  | ($overlay[0] // {}) as $o
  | $c
  | .require = (($c.require // {}) + ($o.require // {}))
  | .repositories = ($o.repositories // [])
  ' > "$tmp_out"

mv "$tmp_out" "$OUT"

echo "✅ Rebuilt $OUT from $CORE + $OVERLAY"