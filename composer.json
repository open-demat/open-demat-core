{
  "name": "open-demat/core-app",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "composer/installers": "^2.3",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/doctrine-migrations-bundle": "^3.5",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^2.16 || ^3.2",
    "dompdf/dompdf": "^3.1",
    "ecphp/cas-bundle": "^3.0.4",
    "ecphp/cas-lib": "^3",
    "league/flysystem-aws-s3-v3": "^3.30",
    "league/flysystem-bundle": "^3.6",
    "loophp/psr-http-message-bridge-bundle": "^1.2",
    "loophp/psr17": "^1.0",
    "nyholm/psr7": "^1.8",
    "oomphinc/composer-installers-extender": "^2.0 || ^3.0",
    "symfony/asset": "^7.4",
    "symfony/console": "^7.4",
    "symfony/doctrine-messenger": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/form": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/mailer": "^7.4",
    "symfony/messenger": "^7.4",
    "symfony/monolog-bundle": "^3.11",
    "symfony/orm-pack": "^2.4",
    "symfony/password-hasher": "^7.4",
    "symfony/property-info": "^7.4",
    "symfony/psr-http-message-bridge": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/twig-bridge": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/uid": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/var-exporter": "^7.4",
    "symfony/workflow": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "OpenDemat\\Core\\": "src/",
      "OpenDemat\\AdminBundle\\": "app_open_demat/admin-bundle/src/",
      "OpenDemat\\ExampleBundle\\": "app_open_demat/example-bundle/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenDemat\\Core\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true,
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": true
    },
    "installer-types": [
      "open-demat-bundle"
    ],
    "installer-paths": {
      "app_open_demat/{$name}/": [
        "type:open-demat-bundle"
      ]
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-symfony": "^2.0",
    "symfony/debug-bundle": "^7.4",
    "symfony/test-pack": "^1.2",
    "symfony/web-profiler-bundle": "^7.4"
  },
  "scripts": {
    "post-install-cmd": [
      "bash bin/composer-build"
    ],
    "post-update-cmd": [
      "bash bin/composer-build"
    ],
    "db:test:reset": [
      "APP_ENV=test php bin/console doctrine:database:create --if-not-exists",
      "APP_ENV=test php bin/console doctrine:schema:drop --force --full-database",
      "APP_ENV=test php bin/console doctrine:schema:create"
    ],
    "test": "APP_ENV=test vendor/bin/phpunit -c phpunit.xml.dist"
  },
  "description": "Open Demat Symfony core application for modular business-process platforms.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/open-demat/open-demat-core",
  "support": {
    "issues": "https://github.com/open-demat/open-demat-core/issues"
  },
  "repositories": []
}
