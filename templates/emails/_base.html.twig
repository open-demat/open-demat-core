{# templates/emails/_base.html.twig #}
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block email_title %}{{ title|default('Courriers — Notification') }}{% endblock %}</title>
  </head>

  <body style="margin:0;padding:0;background:#f6f7f9;">

    {# Preheader (caché) #}
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      {% block preheader %}{{ preheader|default('Notification Courriers') }}{% endblock %}
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background:#f6f7f9;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="border-collapse:collapse;width:600px;max-width:600px;">

            {# Header / Logo #}
            <tr>
              <td style="padding:0 0 12px 0;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                  <tr>
                    <td align="left" style="padding:0;">
                      {# admin_url doit être fourni côté mailer context, comme dans CSST #}
                      <img
                        src="{{ organization_logo|default('') ? admin_url ~ '/' ~ organization_logo : admin_url ~ '/assets/img/open-demat-imgs/system.svg' }}"
                        alt="{{ organization_name|default('Open Demat') }}"
                        width="160"
                        style="display:block;border:0;outline:none;text-decoration:none;max-width:160px;height:auto;">
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {# Card #}
            <tr>
              <td style="background:#ffffff;border:1px solid #e6e8eb;border-radius:12px;padding:22px;">
                <div style="font-family:Arial,Helvetica,sans-serif;color:#111111;line-height:1.5;">

                  {# Bonjour #}
                  {% block greeting %}
                    {% if recipient_name is defined and recipient_name %}
                      <p style="margin:0 0 14px 0;font-size:16px;">Bonjour {{ recipient_name }},</p>
                    {% else %}
                      <p style="margin:0 0 14px 0;font-size:16px;">Bonjour,</p>
                    {% endif %}
                  {% endblock %}

                  {# Titre #}
                  <h1 style="margin:0 0 10px 0;font-size:18px;line-height:1.3;color:#111111;">
                    {% block heading %}{{ title|default('Courriers — Notification') }}{% endblock %}
                  </h1>

                  {# Message principal #}
                  <div style="margin:0 0 14px 0;font-size:14px;color:#333333;">
                    {% block content %}{% endblock %}
                  </div>

                  {# Bouton optionnel #}
                  {% block cta %}
                    {% if cta_url is defined and cta_url %}
                      <table role="presentation" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:12px 0 0 0;">
                        <tr>
                          <td align="left">
                            <a href="{{ cta_url }}"
                               style="display:inline-block;background:#E42535;color:#ffffff;text-decoration:none;font-weight:700;font-size:14px;padding:10px 14px;border-radius:10px;">
                              {{ cta_label|default('Ouvrir') }}
                            </a>
                          </td>
                        </tr>
                      </table>
                    {% endif %}
                  {% endblock %}

                  {# Note / disclaimer #}
                  <p style="margin:16px 0 0 0;font-size:12px;color:#666666;line-height:1.5;">
                    {% block disclaimer %}
                      Cet e-mail est une notification automatique.
                      Si vous n’êtes pas concerné, vous pouvez ignorer ce message.
                    {% endblock %}
                  </p>

                </div>
              </td>
            </tr>

            {# Footer #}
            <tr>
              <td style="padding:14px 6px 0 6px;">
                <div style="font-family:Arial,Helvetica,sans-serif;color:#666666;line-height:1.5;font-size:12px;text-align:left;">
                  {% block footer %}
                    <p style="margin:0 0 6px 0;">La plateforme de dématérialisation de {{ organization_name|default('Open Demat') }}</p>
                  {% endblock %}
                </div>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
