<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">

  {% set orgName = organization_name|default('Open Demat') %}
  {% set orgLogo = organization_logo|default('') %}
  {% set themePrimaryColor = theme_primary_color|default('#E42535') %}
  {% set themePrimaryDarkColor = theme_primary_dark_color|default('#B51E2A') %}

  <title>Portail des applications {{ orgName }}</title>
  <meta name="description" content="Accédez aux applications administratives de {{ orgName }} selon vos droits.">
  <meta name="theme-color" content="{{ themePrimaryColor }}">

  <link rel="icon" href="">
  <link rel="apple-touch-icon" href="">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet">

  <style>
    :root {
      --open-demat-red: {{ themePrimaryColor }};
      --open-demat-red-dark: {{ themePrimaryDarkColor }};
      --portal-red: var(--open-demat-red, #E42535);
      --portal-red-dark: var(--open-demat-red-dark, #b91c2b);
      --portal-soft-bg: #f7f7f8;
    }

    body {
      background: var(--portal-soft-bg);
      padding-top: 76px;
    }

    .skip-link {
      position: absolute;
      left: -999px;
      top: auto;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .skip-link:focus {
      left: 1rem;
      top: 1rem;
      width: auto;
      height: auto;
      z-index: 2000;
      background: #fff;
      color: #000;
      padding: .5rem .75rem;
      border-radius: .5rem;
    }

    #header.portal-header,
    #header.portal-header.fixed-top {
      background: linear-gradient(135deg, var(--portal-red), var(--portal-red-dark)) !important;
      background-color: var(--portal-red) !important;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .14);
    }

    .portal-header .logo {
      display: inline-flex;
      align-items: center;
      gap: .75rem;
      color: #fff;
      text-decoration: none;
      min-width: 0;
    }

    .portal-brand-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #fff;
      color: var(--portal-red);
      font-size: 1.55rem;
      flex-shrink: 0;
    }

    .portal-brand-logo {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .portal-title {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
      min-width: 0;
    }

    .portal-title strong {
      font-size: 1rem;
      font-weight: 700;
      white-space: nowrap;
      color: #fff;
    }

    .portal-title span {
      font-size: .82rem;
      opacity: .9;
      white-space: nowrap;
      color: #fff;
    }

    .portal-actions {
      display: flex;
      align-items: center;
      gap: .5rem;
      flex-shrink: 0;
    }

    .portal-action-btn {
      color: #fff !important;
      background: rgba(255, 255, 255, .18) !important;
      border: 1px solid rgba(255, 255, 255, .35) !important;
      border-radius: 999px;
      font-weight: 600;
      box-shadow: none !important;
    }

    .portal-action-btn:hover,
    .portal-action-btn:focus,
    .portal-action-btn:active,
    .portal-action-btn.show {
      color: #fff !important;
      background: rgba(255, 255, 255, .28) !important;
      border-color: rgba(255, 255, 255, .5) !important;
      box-shadow: none !important;
    }

    .portal-user-menu .dropdown-menu {
      border: 0;
      border-radius: 14px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, .16);
      overflow: hidden;
    }

    .portal-hero {
      background: #fff;
      border: 1px solid #ececec;
      border-radius: 24px;
      padding: 2.5rem 1.5rem;
      box-shadow: 0 14px 30px rgba(0, 0, 0, .05);
    }

    .page-title {
      font-weight: 800;
      color: #1f2933;
    }

    .page-intro {
      color: #667085;
      font-size: 1.05rem;
    }

    .apps-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .apps-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 1200px) {
      .apps-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .app-card {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 20px;
      padding: 1.25rem;
      box-shadow: 0 10px 22px rgba(0, 0, 0, .05);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .app-card:hover {
      transform: translateY(-2px);
      border-color: rgba(228, 37, 53, .28);
      box-shadow: 0 16px 34px rgba(0, 0, 0, .08);
    }

    .app-icon {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fff;
      border-radius: 14px;
      border: 1px solid #e9ecef;
      overflow: hidden;
      flex-shrink: 0;
    }

    .app-icon-img {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
    }

    .app-card h3 {
      font-size: 1.1rem;
      font-weight: 700;
      color: #1f2933;
    }

    .app-card p {
      color: #667085;
    }

    .app-actions {
      margin-top: auto;
      padding-top: 1rem;
    }

    #footer {
      background: #fff;
      border-top: 1px solid #e9ecef;
      padding: .85rem 0;
      color: #667085;
      font-size: .9rem;
    }

    @media (max-width: 575.98px) {
      body {
        padding-top: 68px;
      }

      .portal-brand-icon {
        width: 38px;
        height: 38px;
      }

      .portal-title strong {
        font-size: .92rem;
      }

      .portal-title span {
        display: none;
      }

      .portal-action-btn {
        padding-left: .55rem;
        padding-right: .55rem;
      }

      .portal-hero {
        padding: 1.5rem 1rem;
        border-radius: 18px;
      }

      .page-title {
        font-size: 1.65rem;
      }
    }
  </style>
</head>

<body class="d-flex flex-column h-100">
  <a href="#main" class="skip-link">Aller au contenu principal</a>

  <header id="header" class="portal-header fixed-top" role="banner">
    <div class="container d-flex align-items-center justify-content-between py-2 gap-3">
      <a href="{{ path('app_home') }}" class="logo" aria-label="Accueil {{ orgName }}">
        <span class="portal-brand-icon" aria-hidden="true">
          {% if orgLogo %}
            <img src="{{ asset(orgLogo) }}" alt="" class="portal-brand-logo">
          {% else %}
            <i class="bx bxs-grid-alt"></i>
          {% endif %}
        </span>

        <span class="portal-title">
          <strong>Portail {{ orgName }}</strong>
          <span>Applications administratives</span>
        </span>
      </a>

      {% if app.user %}
        <div class="portal-actions">
          <button type="button"
                  class="btn btn-sm portal-action-btn position-relative"
                  id="taskInboxBtn"
                  data-task-inbox-btn="1"
                  data-bs-toggle="modal"
                  data-bs-target="#taskInboxModal"
                  data-url="{{ path('core_tasks_inbox') }}"
                  data-count-url="{{ path('core_tasks_inbox_count') }}">
            <i class="bx bx-task" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Tâches</span>

            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                  id="taskInboxCount">
              0
            </span>
          </button>

          <div class="dropdown portal-user-menu">
            <button
              class="btn btn-sm portal-action-btn dropdown-toggle d-flex align-items-center gap-2"
              type="button"
              id="userMenuDropdown"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="bx bx-user-circle" aria-hidden="true"></i>
              <span class="d-none d-sm-inline">{{ app.user.userIdentifier }}</span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
              <li>
                <a class="dropdown-item" href="{{ path('open_demat_core_profile_index') }}">
                  <i class="bx bx-id-card me-2" aria-hidden="true"></i>
                  Mon profil
                </a>
              </li>

              <li><hr class="dropdown-divider"></li>

              <li>
                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                  <i class="bx bx-log-out me-2" aria-hidden="true"></i>
                  Déconnexion
                </a>
              </li>
            </ul>
          </div>
        </div>
      {% endif %}
    </div>
  </header>

  <main id="main" role="main" class="flex-grow-1">
    <div class="container py-5">
      {% set apps = app_hub_apps|default([]) %}
      {% set hasIntegratedApp = false %}

      {% for hubApp in apps %}
        {% set allowed = false %}

        {% for role in hubApp.roles|default([]) %}
          {% if is_granted(role) %}
            {% set allowed = true %}
          {% endif %}
        {% endfor %}

        {% if allowed %}
          {% set hasIntegratedApp = true %}
        {% endif %}
      {% endfor %}

      <div class="portal-hero text-center mb-5">
        <h1 class="page-title mb-2">
          Portail des applications administratives {{ orgName }}
        </h1>

        <p class="page-intro mb-0">
          Retrouvez ici les applications auxquelles vous avez accès selon votre profil.
        </p>
      </div>

      <section class="text-start mx-auto" style="max-width:1100px">
        <div class="mb-3">
          <h2 class="h4 m-0">Applications disponibles</h2>
          <p class="text-body-secondary m-0">
            Disponibles selon vos droits CAS et vos rôles applicatifs.
          </p>
        </div>

        {% if not hasIntegratedApp %}
          <div class="alert alert-light border rounded-4">
            <p class="m-0">
              Vous n’avez accès à aucune application pour le moment.
              <br>
              <span class="text-body">
                Si c’est anormal, contactez le support afin d’obtenir les droits nécessaires.
              </span>
            </p>
          </div>
        {% else %}
          <ul class="apps-list">
            {% for hubApp in apps %}
              {% set allowed = false %}

              {% for role in hubApp.roles|default([]) %}
                {% if is_granted(role) %}
                  {% set allowed = true %}
                {% endif %}
              {% endfor %}

              {% if allowed %}
                <li>
                  <article class="app-card h-100">
                    <div class="d-flex align-items-center gap-3 mb-2">
                      <span class="app-icon">
                        <img
                          src="{{ asset('assets/img/open-demat-imgs/' ~ hubApp.icon) }}"
                          alt="Logo {{ hubApp.title }}"
                          class="app-icon-img"
                        >
                      </span>

                      <h3 class="m-0">{{ hubApp.title }}</h3>
                    </div>

                    {% if hubApp.desc is defined and hubApp.desc %}
                      <p class="mt-2 mb-0">{{ hubApp.desc }}</p>
                    {% endif %}

                    <div class="app-actions">
                      <a href="{{ hubApp.url }}" class="btn btn-open-demat">
                        Accéder
                      </a>
                    </div>
                  </article>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    </div>
  </main>

  {% if app.user %}
    {% include 'task/_inbox_modal.html.twig' %}
  {% endif %}

  <footer id="footer">
    <div class="container text-center">
      <p class="m-0">
        Plateforme powered by
        <a href="https://github.com/open-demat" target="_blank" rel="noopener noreferrer">
          Open Demat
        </a>.
      </p>
    </div>
  </footer>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  {% if app.user %}
    <script src="{{ asset('assets/js/task-inbox.js') }}"></script>
  {% endif %}
</body>
</html>
