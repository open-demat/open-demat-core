{% extends 'base.html.twig' %}

{% block title %}Connexion · {{ organization_name|default('Open Demat') }}{% endblock %}

{% block body %}
  <div class="min-vh-100 d-flex align-items-center justify-content-center bg-light px-3">
    <div class="w-100" style="max-width: 520px;">
      <div class="text-center mb-4">
        {% if organization_logo|default('') %}
          <img src="{{ asset(organization_logo) }}" alt="" class="mb-3" style="max-height: 64px; max-width: 120px; object-fit: contain;">
        {% endif %}
        <h1 class="h3 mb-2">{{ organization_name|default('Open Demat') }}</h1>
        <p class="text-secondary mb-0">Choisissez votre mode de connexion</p>
      </div>

      {% if error %}
        <div class="alert alert-danger" role="alert">
          {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
      {% endif %}

      <div class="d-grid gap-3">
        {% if shibboleth_enabled and shibboleth_login_url %}
          <a class="btn btn-primary btn-lg d-flex align-items-center justify-content-center gap-2"
             href="{{ shibboleth_login_url }}">
            <i class="bx bx-id-card" aria-hidden="true"></i>
            <span>Connexion Shibboleth</span>
          </a>
        {% endif %}

        <a class="btn btn-outline-primary btn-lg d-flex align-items-center justify-content-center gap-2"
           href="{{ path('caslogin', {'_target_path': target_path}) }}">
          <i class="bx bx-log-in-circle" aria-hidden="true"></i>
          <span>Connexion CAS</span>
        </a>
      </div>
    </div>
  </div>
{% endblock %}
