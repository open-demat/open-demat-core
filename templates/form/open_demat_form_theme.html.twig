{# templates/form/open_demat_form_theme.html.twig #}
{% use "bootstrap_5_layout.html.twig" %}

{# ==========================================================
   Label : ajoute automatiquement * quand required = true
   + RGAA : texte caché “champ obligatoire”
   ========================================================== #}
{% block form_label %}
  {% if label is not same as(false) %}
    {# Conserve le comportement Bootstrap (classes label, etc.) #}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ (required ? ' required' : ''))|trim}) %}

    <label
      {% if label_attr %}{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}{% endif %}
      {% if id is defined and id %} for="{{ id }}"{% endif %}
    >
      {{ label|trans(label_translation_parameters, translation_domain) }}

      {% if required %}
        <span class="text-danger ms-1" aria-hidden="true">*</span>
        <span class="visually-hidden"> (champ obligatoire)</span>
      {% endif %}
    </label>
  {% endif %}
{% endblock %}

{# Optionnel : si tu veux marquer l’input required d’une classe (utile pour CSS) #}
{% block form_widget_simple %}
  {% set attr = attr|merge({class: (attr.class|default('') ~ (required ? ' is-required' : ''))|trim}) %}
  {{ parent() }}
{% endblock %}
