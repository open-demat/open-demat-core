{% extends 'base.html.twig' %}

{% block title %}
  Erreur serveur
{% endblock %}

{% block body %}
{% set portalUrl = admin_url is defined and admin_url
    ? (admin_url starts with 'http' ? admin_url : 'http://' ~ admin_url)
    : '/'
%}

<div class="container py-5 text-center">

  <h1 class="display-3 text-danger fw-bold">
    500
  </h1>

  <h2 class="mb-3">
    Erreur interne du serveur
  </h2>

  <p class="text-muted">
    Une erreur inattendue s'est produite sur le serveur.
    Notre équipe a été automatiquement notifiée.
  </p>

  <div class="mt-4 d-flex justify-content-center gap-3">

    <a href="{{ portalUrl }}" class="btn btn-danger">
      Retour au portail
    </a>

    <a href="javascript:location.reload()" class="btn btn-outline-secondary">
      Réessayer
    </a>

  </div>

</div>
{% endblock %}
