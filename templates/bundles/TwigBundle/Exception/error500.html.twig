{% extends 'base.html.twig' %}

{% block title %}
  Erreur serveur
{% endblock %}

{% block body %}
<div class="container py-5 text-center">

  <h1 class="display-3 text-danger fw-bold">
    500
  </h1>

  <h2 class="mb-3">
    Erreur interne du serveur
  </h2>

  <p class="text-muted">
    Une erreur inattendue s'est produite sur le serveur.
    Notre équipe a été automatiquement notifiée.
  </p>

  <div class="mt-4 d-flex justify-content-center gap-3">

    <a href="{{ path('app_home') }}" class="btn btn-danger">
      Retour à l’accueil
    </a>

    <a href="javascript:location.reload()" class="btn btn-outline-secondary">
      Réessayer
    </a>

  </div>

</div>
{% endblock %}