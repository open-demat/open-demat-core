{% extends 'base.html.twig' %}

{% block title %}Accès refusé{% endblock %}

{% block body %}
{% set portalUrl = admin_url is defined and admin_url
    ? (admin_url starts with 'http' ? admin_url : 'http://' ~ admin_url)
    : '/'
%}

<div class="container py-5 text-center">
    <h1 class="display-4 text-danger">403</h1>
    <h2 class="mb-3">Accès refusé</h2>

    <p class="text-muted">
        Vous n’avez pas les droits pour accéder à cette page.
    </p>

    <a href="{{ portalUrl }}" class="btn btn-primary mt-3">
        Retour au portail
    </a>
</div>
{% endblock %}
