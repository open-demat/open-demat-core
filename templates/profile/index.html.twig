{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
/* =========================
   Profil – responsive docs
   ========================= */

.open-demat-profile .card{
  background: var(--card-bg);
  box-shadow: var(--card-shadow);
  border: 1px solid var(--border);
  border-radius: 12px;
}

/* Cartes documents (mobile) */
.open-demat-doc-card{
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1rem;
  box-shadow: var(--card-shadow);
}

/* Key/Value (dl) propre et lisible */
.open-demat-kv{
  display: grid;
  gap: .5rem .75rem;
}
.open-demat-kv > div{
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: .5rem;
  align-items: start;
}
.open-demat-kv dt{
  font-weight: 700;
}
.open-demat-kv dd{
  margin: 0;
}

/* Checkbox alignée et cliquable */
.open-demat-check .form-check{
  margin-bottom: 0;
}
.open-demat-check .form-check-input{
  width: 1.1rem;
  height: 1.1rem;
}

  </style>

{% endblock %}

{% block body %}
<div class="container py-4 open-demat-profile">

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Mon profil</h1>
      <div class="text-muted">Modifier vos informations personnelles</div>
    </div>
  </div>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label }} mb-3" role="status">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  <div class="card shadow-sm border-0">
    <div class="card-body p-3 p-md-4">
      {{ form_start(form) }}

      <div class="row g-3">
        {# Identité #}
        <div class="col-12 col-md-6">
          {{ form_row(form.prenom) }}
        </div>
        <div class="col-12 col-md-6">
          {{ form_row(form.nom) }}
        </div>

        <div class="col-12 col-md-6">
          {{ form_row(form.telephone) }}
        </div>
        <div class="col-12 col-md-6">
          {{ form_row(form.email) }}
        </div>

        {# Organisation #}
        <div class="col-12 col-md-6">
          {{ form_row(form.fonction) }}
        </div>
        <div class="col-12 col-md-6">
          {{ form_row(form.service) }}
        </div>

        <div class="col-12 col-md-6">
          {{ form_row(form.site) }}
        </div>
        <div class="col-12 col-md-6">
          {{ form_row(form.username) }}
        </div>

        {# Champs métier (en dernier) #}
        <div class="col-12 col-md-6">
          {{ form_row(form.composante_text) }}
          <div class="form-text">Exemple : UFR Sciences</div>
        </div>

        <div class="col-12 col-md-6">
          {{ form_row(form.dep_composante_text) }}
          <div class="form-text">Exemple : Informatique</div>
        </div>
      </div>

      <div class="d-grid d-md-flex justify-content-md-end gap-2 mt-4">
        <button class="btn btn-primary" type="submit">
          Enregistrer
        </button>
      </div>

      {{ form_end(form) }}
    </div>
  </div>

  <div class="card shadow-sm border-0 mt-4">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <div>
          <h2 class="h5 fw-bold mb-1">Fichiers personnels</h2>
          <div class="text-muted">Ajoutez des documents réutilisables dans vos démarches</div>
        </div>
      </div>

      {{ form_start(uploadForm, { attr: { enctype: 'multipart/form-data' } }) }}

      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-5">
          {{ form_row(uploadForm.file) }}
        </div>
        <div class="col-12 col-md-3">
          {{ form_row(uploadForm.label) }}
        </div>
        <div class="col-12 col-md-2">
          {{ form_row(uploadForm.category) }}
        </div>
        <div class="col-12 col-md-1">
          <div class="open-demat-check">
            {{ form_row(uploadForm.isPinned) }}
          </div>
        </div>
        <div class="col-12 col-md-1 d-grid">
          <button class="btn btn-primary" type="submit">Ajouter</button>
        </div>
      </div>

      {{ form_end(uploadForm) }}

      <hr class="my-4" />

      {% if userDocs is empty %}
        <p class="text-muted mb-0">Aucun document personnel pour le moment.</p>
      {% else %}

        {# ===== Mobile : cartes ===== #}
        <div class="d-md-none">
          <div class="vstack gap-2">
            {% for ud in userDocs %}
              {% set d = ud.document %}
              <article class="open-demat-doc-card" aria-label="Document personnel">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div class="me-2">
                    <div class="fw-semibold">
                      {% if ud.isPinned %}
                        <span class="badge bg-warning text-dark me-2">Épinglé</span>
                      {% endif %}
                      {{ ud.label ?? d.originalName }}
                    </div>
                    <div class="small text-muted text-break">{{ d.originalName }}</div>
                  </div>
                </div>

                <dl class="open-demat-kv mt-2 mb-0">
                  <div>
                    <dt>Type</dt>
                    <dd class="text-muted">{{ d.mimeType }}</dd>
                  </div>
                  <div>
                    <dt>Catégorie</dt>
                    <dd class="text-muted">{{ ud.category ?? '—' }}</dd>
                  </div>
                  <div>
                    <dt>Ajouté le</dt>
                    <dd class="text-muted">{{ ud.createdAt|date('d/m/Y H:i') }}</dd>
                  </div>
                </dl>

                <div class="d-grid gap-2 mt-3">
                  <a class="btn btn-outline-secondary"
                     href="{{ path('open_demat_core_profile_download', {id: ud.id}) }}">
                    Télécharger
                  </a>

                  <form method="post"
                        action="{{ path('open_demat_core_profile_delete', {id: ud.id}) }}"
                        onsubmit="return confirm('Supprimer ce document de vos fichiers personnels ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('ud_delete_' ~ ud.id) }}">
                    <button class="btn btn-outline-danger w-100" type="submit">
                      Supprimer
                    </button>
                  </form>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>

        {# ===== Desktop : table ===== #}
        <div class="d-none d-md-block">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead>
                <tr>
                  <th>Nom</th>
                  <th>Type</th>
                  <th>Catégorie</th>
                  <th>Ajouté le</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
              {% for ud in userDocs %}
                {% set d = ud.document %}
                <tr>
                  <td class="fw-semibold">
                    {% if ud.isPinned %}<span class="badge bg-warning text-dark me-2">Épinglé</span>{% endif %}
                    {{ ud.label ?? d.originalName }}
                    <div class="small text-muted">{{ d.originalName }}</div>
                  </td>
                  <td class="text-muted">{{ d.mimeType }}</td>
                  <td class="text-muted">{{ ud.category ?? '—' }}</td>
                  <td class="text-muted">{{ ud.createdAt|date('d/m/Y H:i') }}</td>
                  <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       href="{{ path('open_demat_core_profile_download', {id: ud.id}) }}">
                      Télécharger
                    </a>

                    <form method="post"
                          action="{{ path('open_demat_core_profile_delete', {id: ud.id}) }}"
                          class="d-inline"
                          onsubmit="return confirm('Supprimer ce document de vos fichiers personnels ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('ud_delete_' ~ ud.id) }}">
                      <button class="btn btn-sm btn-outline-danger" type="submit">
                        Supprimer
                      </button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

      {% endif %}
    </div>
  </div>

</div>
{% endblock %}
