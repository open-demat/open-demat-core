{# templates/task/_inbox_list.html.twig #}

<style>
  .task-inbox-card {
    border: 1px solid #e9ecef;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, .06);
    overflow: hidden;
  }

  .task-inbox-header {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #f0f0f0;
    background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  }

  .task-inbox-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #212529;
  }

  .task-inbox-subtitle {
    margin: .15rem 0 0 0;
    font-size: .85rem;
    color: #6c757d;
  }

  .task-inbox-search {
    max-width: 320px;
    min-width: 220px;
  }

  .task-inbox-empty {
    padding: 1.5rem;
    color: #6c757d;
    margin: 0;
  }

  .task-inbox-table-wrapper {
    overflow: auto;
    max-height: 62vh;
  }

  .task-inbox-table {
    margin: 0;
    white-space: nowrap;
    min-width: 980px;
  }

  .task-inbox-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f8f9fa;
    color: #495057;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .03em;
    border-bottom: 1px solid #dee2e6;
    user-select: none;
  }

  .task-inbox-table tbody tr {
    transition: background-color .15s ease;
  }

  .task-inbox-table tbody tr:hover {
    background: #fff8f8;
  }

  .task-sortable {
    cursor: pointer;
  }

  .task-sortable:hover {
    background: #f1f3f5;
  }

  .task-sortable .sort-indicator {
    display: inline-flex;
    width: 1rem;
    justify-content: center;
    margin-left: .25rem;
    color: #adb5bd;
    font-size: .75rem;
  }

  .task-sortable.is-sorted {
    color: #212529;
  }

  .task-sortable.is-sorted .sort-indicator {
    color: #dc3545;
  }

  .task-process-badge {
    display: inline-flex;
    align-items: center;
    padding: .25rem .55rem;
    border-radius: 999px;
    background: #f1f3f5;
    color: #343a40;
    font-size: .82rem;
    font-weight: 600;
  }

  .task-summary {
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .task-name {
    font-weight: 600;
    color: #212529;
  }

  .task-assignee {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .25rem .5rem;
    border-radius: 999px;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    font-size: .84rem;
  }

  .task-assignee-role {
    background: #fff3cd;
    border-color: #ffe69c;
    color: #664d03;
  }

  .task-date {
    color: #6c757d;
    font-size: .88rem;
  }

  .task-action-btn {
    border-radius: 999px;
    padding: .3rem .75rem;
    font-weight: 600;
  }

  .task-inbox-footer {
    display: flex;
    justify-content: space-between;
    gap: .75rem;
    padding: .75rem 1.25rem;
    border-top: 1px solid #f0f0f0;
    background: #fafafa;
    color: #6c757d;
    font-size: .85rem;
  }

  .task-hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .task-inbox-header {
      align-items: stretch;
    }

    .task-inbox-search {
      max-width: none;
      width: 100%;
    }

    .task-summary {
      max-width: 240px;
    }
  }
</style>

{% if tasks is empty %}
  <div class="task-inbox-card">
    <p class="task-inbox-empty">
      Aucune tâche en cours pour le moment.
    </p>
  </div>
{% else %}
  <div class="task-inbox-card" data-task-inbox>
    <div class="task-inbox-header">
      <div>
        <h2 class="task-inbox-title">Tâches en cours</h2>
        <p class="task-inbox-subtitle">
          {{ tasks|length }} tâche{{ tasks|length > 1 ? 's' : '' }} à traiter
        </p>
      </div>

      <div class="task-inbox-search">
        <input
          type="search"
          class="form-control form-control-sm"
          data-task-search
          placeholder="Rechercher une tâche..."
          aria-label="Rechercher une tâche"
        >
      </div>
    </div>

    <div class="task-inbox-table-wrapper">
      <table class="table table-sm align-middle task-inbox-table" data-task-table>
        <thead>
          <tr>
            <th class="task-sortable" data-column-index="0" data-sort-type="text">
              Processus <span class="sort-indicator">↕</span>
            </th>

            <th class="task-sortable" data-column-index="1" data-sort-type="text">
              Objet <span class="sort-indicator">↕</span>
            </th>

            <th class="task-sortable" data-column-index="2" data-sort-type="text">
              Tâche <span class="sort-indicator">↕</span>
            </th>

            <th class="task-sortable" data-column-index="3" data-sort-type="text">
              Assignée à <span class="sort-indicator">↕</span>
            </th>

            <th class="task-sortable" data-column-index="4" data-sort-type="number">
              Créée le <span class="sort-indicator">↕</span>
            </th>

            <th class="text-end">
              Action
            </th>
          </tr>
        </thead>

        <tbody>
          {% for task in tasks %}
            {% set assignee %}
              {% if task.user %}
                {{ task.user.userIdentifier }}
              {% elseif task.roleName %}
                {{ task.roleName }}
              {% else %}
                Non assignée
              {% endif %}
            {% endset %}

            <tr data-task-row>
              <td data-sort-value="{{ task.processName|default('')|lower|e('html_attr') }}">
                <span class="task-process-badge">
                  {{ task.processName }}
                </span>
              </td>

              <td
                class="task-summary"
                title="{{ task.summary|default('')|e('html_attr') }}"
                data-sort-value="{{ task.summary|default('')|lower|e('html_attr') }}"
              >
                {{ task.summary }}
              </td>

              <td data-sort-value="{{ task.taskName|default('')|lower|e('html_attr') }}">
                <span class="task-name">
                  {{ task.taskName }}
                </span>
              </td>

              <td data-sort-value="{{ assignee|striptags|trim|lower|e('html_attr') }}">
                {% if task.user %}
                  <span class="task-assignee">
                    {{ task.user.userIdentifier }}
                  </span>
                {% elseif task.roleName %}
                  <span class="task-assignee task-assignee-role">
                    {{ task.roleName }}
                  </span>
                {% else %}
                  <span class="text-muted">Non assignée</span>
                {% endif %}
              </td>

              <td
                class="task-date"
                data-sort-value="{{ task.createdAt|date('U') }}"
              >
                {{ task.createdAt|date('d/m/Y H:i') }}
              </td>

              <td class="text-end">
                <a
                  class="btn btn-sm btn-primary task-action-btn"
                  href="{{ task.actionRoute }}"
                >
                  Aller
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="task-inbox-footer">
      <span data-task-count>
        {{ tasks|length }} tâche{{ tasks|length > 1 ? 's' : '' }} affichée{{ tasks|length > 1 ? 's' : '' }}
      </span>

      <span>
        Cliquez sur les colonnes pour trier
      </span>
    </div>
  </div>
{% endif %}