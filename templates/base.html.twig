{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="x-ua-compatible" content="ie=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta charset="UTF-8"/>
    {% set orgName = organization_name|default('Open Demat') %}
    {% set orgLogo = organization_logo|default('') %}

    <meta name="description" content="Portail d'administration {{ orgName }}"/>

    <title>{% block title %}{{ orgName }} · Administration{% endblock %}</title>

    {% block stylesheets %}
      {# Bootstrap 5 #}
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

      {# Icônes (optionnel) #}
      <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

      {# DataTables + Bootstrap 5 + Buttons (si tu en as besoin partout) #}
      <link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css">
      <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.1/css/buttons.bootstrap5.min.css">

      {# Style commun Open Demat #}
      <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet"/>
    {% endblock %}

    <script>
      (function () {
        try {
          const key = 'open-demat_sidebar_collapsed';
          const collapsed = localStorage.getItem(key) === 'true';
          if (collapsed) {
            document.documentElement.classList.add('open-demat-sidebar-collapsed');
          }
        } catch (e) {}
      })();
    </script>

  </head>

  <body class="min-vh-100 d-flex flex-column">
    {# Lien d’évitement pour RGAA #}
    <a href="#main" class="skip-link">Aller au contenu</a>

    {% set hideNavbarRoutes = ['app_login'] %}
    {% set withSidebar = app.request.attributes.get('_route') not in hideNavbarRoutes %}

    {# --- TOPBAR (toujours visible quand on a une sidebar) --- #}
    {% if withSidebar %}
    <nav id="open-dematTopbar" class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid">

        <div class="d-flex align-items-center gap-2">
          {# Bouton desktop pour cacher/afficher la sidebar (à gauche du header) #}
          <button type="button"
                  id="toggleSidebarBtn"
                  class="btn btn-sm btn-outline-secondary only-desktop-834 align-items-center"
                  aria-label="Réduire le menu de navigation"
                  aria-expanded="true">
            <i class="bx bx-chevrons-left" aria-hidden="true"></i>
          </button>

          {# Brand #}
          <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
            {% if orgLogo %}
              <img src="{{ asset(orgLogo) }}" alt="" class="me-2" style="height: 28px; max-width: 42px; object-fit: contain;">
            {% else %}
              <i class="bx bxs-grid-alt me-2" aria-hidden="true"></i>
            {% endif %}
            <span>Portail {{ orgName }}</span>
          </a>
        </div>

        <div class="ms-auto d-flex align-items-center gap-2">
          {# Bouton burger pour mobile (offcanvas) #}
          <button class="btn btn-outline-secondary hide-desktop-834"
                  type="button"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#mobileSidebar"
                  aria-controls="mobileSidebar"
                  aria-label="Ouvrir le menu">
            <i class="bx bx-menu"></i>
          </button>

          {# Zone actions TOPBAR uniquement desktop #}
          <div class="only-desktop-834-flex align-items-center gap-2">
            {% if app.user %}
              {# Bouton banette de tâches #}
              <button type="button"
                      class="btn btn-sm btn-outline-secondary position-relative"
                      id="taskInboxBtn"
                      data-task-inbox-btn="1"
                      data-bs-toggle="modal"
                      data-bs-target="#taskInboxModal"
                      data-url="{{ path('core_tasks_inbox') }}"
                      data-count-url="{{ path('core_tasks_inbox_count') }}">
                <i class="bx bx-task" aria-hidden="true"></i>
                <span class="d-none d-sm-inline">Tâches</span>
                {# Badge de nombre #}
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                      id="taskInboxCount">
                  0
                </span>
              </button>

              <div class="dropdown">
                <button
                  class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                  type="button"
                  id="userMenuDropdown"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >
                  <i class="bx bx-user-circle" aria-hidden="true"></i>
                  <span class="d-none d-sm-inline">{{ app.user.userIdentifier }}</span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                  <li>
                    <a class="dropdown-item" href="{{ path('open_demat_core_profile_index') }}">
                      <i class="bx bx-id-card me-2" aria-hidden="true"></i>
                      Mon profil
                    </a>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                      <i class="bx bx-log-out me-2" aria-hidden="true"></i>
                      Déconnexion
                    </a>
                  </li>
                </ul>
              </div>
            {% endif %}
          </div>

        </div>
      </div>
    </nav>
    {% endif %}

    <div class="{{ withSidebar ? 'app-shell d-flex flex-grow-1' : 'flex-grow-1' }}">
      {% if withSidebar %}
        {# Sidebar fixe sur md+ #}
        {% include '_partials/_navbar.html.twig' with {
          sidebar_id: 'sidebarMenu',
          extra_classes: 'sidebar-desktop-834'
        } %}
      {% endif %}

      <main
        id="main"
        role="main"
        aria-live="polite"
        class="{{ withSidebar ? 'flex-grow-1 p-4 app-content' : 'p-0' }}"
      >
        <div class="container-fluid" style="padding-bottom: 64px;">
          {% block body %}{% endblock %}
        </div>
      </main>
    </div>

    {# --- OFFCANVAS pour mobile --- #}
    {% if withSidebar %}
      <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
          <h5 class="offcanvas-title" id="mobileSidebarLabel">
            Portail {{ orgName }}
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body p-0">
          {# On réutilise la même partial, avec d'autres classes / id #}
          {% include '_partials/_navbar.html.twig' with {
            sidebar_id: 'mobileSidebarMenu',
            extra_classes: 'h-100'
          } %}
        </div>
      </div>
    {% endif %}

    {# --- MODAL BANETTE DE TÂCHES --- #}
    {% if app.user %}
      {% include 'task/_inbox_modal.html.twig' %}
    {% endif %}

    {# --- FOOTER FIXE --- #}
    <footer class="bg-white border-top py-2 position-fixed bottom-0 start-0 end-0" role="contentinfo">
      <div class="container text-center small">
        <span>{{ orgName }} &copy; {{ "now"|date("Y") }}. Tous droits réservés.</span>
      </div>
    </footer>

    {% block javascripts %}
      {# jQuery pour DataTables (Bootstrap 5 n'en a pas besoin) #}
      <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

      {# Bootstrap 5 JS #}
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

      {# DataTables + Bootstrap 5 + Buttons #}
      <script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
      <script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/3.0.1/js/dataTables.buttons.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/3.0.1/js/buttons.bootstrap5.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/3.0.1/js/buttons.html5.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/3.0.1/js/buttons.print.min.js"></script>

      <script>
        window.addEventListener('DOMContentLoaded', () => {

          // --- Topbar height -> CSS var (pour sidebar fixed) ---
          const topbar = document.getElementById('open-dematTopbar');

          function syncTopbarHeight(){
            if (!topbar) return;
            const h = Math.ceil(topbar.getBoundingClientRect().height);
            document.documentElement.style.setProperty('--topbar-h', h + 'px');
          }

          syncTopbarHeight();
          window.addEventListener('resize', syncTopbarHeight);

          // --- Toggle sidebar desktop + persistance ---
          const SIDEBAR_STORAGE_KEY = 'open-demat_sidebar_collapsed';

          const toggleBtn = document.getElementById('toggleSidebarBtn');
          const appShell = document.querySelector('.app-shell');

          if (toggleBtn && appShell) {
            const icon = toggleBtn.querySelector('i');

            // sync initial (déjà appliqué sur <html>)
            const collapsed = document.documentElement.classList.contains('open-demat-sidebar-collapsed');
            if (collapsed) appShell.classList.add('sidebar-collapsed');
            toggleBtn.setAttribute('aria-expanded', String(!collapsed));
            if (icon) {
              icon.classList.toggle('bx-chevrons-left', !collapsed);
              icon.classList.toggle('bx-chevrons-right', collapsed);
            }

            toggleBtn.addEventListener('click', () => {
              document.documentElement.classList.toggle('open-demat-sidebar-collapsed');
              const collapsedNow = document.documentElement.classList.contains('open-demat-sidebar-collapsed');

              appShell.classList.toggle('sidebar-collapsed', collapsedNow);
              localStorage.setItem(SIDEBAR_STORAGE_KEY, String(collapsedNow));

              toggleBtn.setAttribute('aria-expanded', String(!collapsedNow));
              if (icon) {
                icon.classList.toggle('bx-chevrons-left', !collapsedNow);
                icon.classList.toggle('bx-chevrons-right', collapsedNow);
              }
            });
          }

          // --- Init DataTables générique ---
          document.querySelectorAll('.datatable').forEach(tbl => {
            new DataTable(tbl, {
              layout: {
                topStart: 'search',
                topEnd: 'pageLength',
                bottomStart: 'info',
                bottomEnd: 'paging'
              },
              buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            });
          });

        });
      </script>

      {% if app.user %}
        <script src="{{ asset('assets/js/task-inbox.js') }}"></script>
      {% endif %}
    {% endblock %}
  </body>
</html>
